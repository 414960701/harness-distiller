{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-distiller.local/schemas/blueprint-v1.json",
  "title": "Harness Distiller Blueprint v1",
  "type": "object",
  "required": [
    "schema_version",
    "recipe",
    "level",
    "surfaces",
    "stack",
    "execution",
    "security",
    "providers",
    "distribution",
    "product_acceptance_ref",
    "capabilities",
    "non_goals",
    "evidence",
    "decisions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "recipe": {"type": "string", "minLength": 1},
    "level": {"enum": ["runnable", "usable", "productive", "polished"]},
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["headless", "cli", "tui", "ide", "desktop", "web", "sdk"]}
    },
    "stack": {"type": "string", "minLength": 1},
    "execution": {"type": "string", "minLength": 1},
    "security": {"type": "string", "minLength": 1},
    "providers": {"type": "array"},
    "distribution": {"type": "array"},
    "product_acceptance_ref": {
      "type": ["string", "null"]
    },
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["introduced_at", "target_level", "status", "contract_version", "acceptance_ref"],
        "properties": {
          "introduced_at": {"enum": ["runnable", "usable", "productive", "polished"]},
          "target_level": {"enum": ["runnable", "usable", "productive", "polished"]},
          "status": {"enum": ["selected", "implemented", "verified", "deferred", "blocked-by-evidence"]},
          "contract_version": {"type": "integer", "minimum": 1},
          "acceptance_ref": {"type": "string"},
          "implementation": {"type": "array", "items": {"type": "string"}},
          "tests": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "evidence": {"type": "object"},
    "decisions": {"type": "object"}
  }
}
