{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-distiller.local/schemas/tool-spec-v1.json",
  "title": "Harness ToolSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "description",
    "inputSchema",
    "capabilities",
    "sideEffect",
    "idempotency",
    "timeoutMs",
    "concurrency",
    "approvalHint"
  ],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "inputSchema": {"type": "object"},
    "outputSchema": {"type": ["object", "null"]},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sideEffect": {
      "enum": ["none", "local_reversible", "local_irreversible", "external_reversible", "external_irreversible"]
    },
    "idempotency": {"enum": ["idempotent", "keyed", "non_idempotent"]},
    "timeoutMs": {"type": "integer", "minimum": 1},
    "concurrency": {"enum": ["parallel", "serialized", "resource_locked"]},
    "approvalHint": {"enum": ["never", "policy", "always"]}
  }
}
